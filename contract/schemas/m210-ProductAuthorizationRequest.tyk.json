{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "m210.ProductAuthorizationRequest.tyk",
  "title": "m210 ProductAuthorizationRequest (TYK OpenAPI)",
  "description": "Converted from src/main/resources/openapi/tyk.yml implementation. Service tag 0.0.15.0.6. Not from product docs.",
  "type": "object",
  "allOf": [
    {
      "$ref": "#/definitions/ProductAuthorizationRequest"
    }
  ],
  "definitions": {
    "CbiRequest": {
      "type": "object",
      "required": [
        "tranRequest"
      ],
      "properties": {
        "tranRequest": {
          "$ref": "#/definitions/TransactionRequest"
        }
      },
      "additionalProperties": false,
      "description": "Запрос в формате CBI"
    },
    "TransactionRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parties",
        "kind",
        "lifePhase",
        "localTime",
        "userAttrs"
      ],
      "properties": {
        "parties": {
          "$ref": "#/definitions/Parties"
        },
        "match": {
          "$ref": "#/definitions/Match"
        },
        "moneys": {
          "$ref": "#/definitions/Moneys"
        },
        "userAttrs": {
          "$ref": "#/definitions/UserAttrs"
        },
        "preprocessOnly": {
          "type": "boolean"
        },
        "specific": {
          "$ref": "#/definitions/Specific"
        },
        "networkSpecific": {
          "$ref": "#/definitions/NetworkSpecific"
        },
        "localTime": {
          "type": "string",
          "description": "Локальное время транзакции",
          "pattern": "^\\d{4}-[01]\\d-[0-3]\\dT[012]\\d:[012345]\\d:[012345]\\d.\\d{3}$"
        },
        "originatorDay": {
          "type": "string",
          "description": "День инициации транзакции",
          "pattern": "^\\d{4}-[01]\\d-[0-3]\\dT[012]\\d:[012345]\\d:[012345]\\d.\\d{3}$"
        },
        "kind": {
          "type": "string",
          "maxLength": 255,
          "example": "Goods",
          "description": "Тип транзакции"
        },
        "lifePhase": {
          "type": "string",
          "maxLength": 255,
          "example": "Auth",
          "description": "Фаза жизненного цикла транзакции"
        },
        "isBackward": {
          "type": "boolean",
          "description": "Флаг обратной транзакции"
        },
        "isReversal": {
          "type": "boolean",
          "description": "Флаг реверса"
        },
        "isPartial": {
          "type": "boolean",
          "description": "Флаг частичного выполнения"
        },
        "isAdvice": {
          "type": "boolean",
          "description": "Флаг совета"
        },
        "link": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/definitions/Link"
          },
          "description": "Связанные транзакции"
        },
        "undoState": {
          "type": "string",
          "maxLength": 255,
          "example": "Normal"
        },
        "linkedData": {
          "$ref": "#/definitions/LinkedData"
        },
        "version": {
          "type": "string",
          "maxLength": 255,
          "example": "3.2.42.10.19"
        },
        "approvalCode": {
          "type": "string",
          "maxLength": 255,
          "example": "AQ6FM9",
          "description": "Код одобрения"
        },
        "result": {
          "type": "string",
          "maxLength": 255
        }
      }
    },
    "LinkedData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "moneys"
      ],
      "properties": {
        "linkedRId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "description": "Идентификатор операции, с которой была установлена связь"
        },
        "moneys": {
          "$ref": "#/definitions/Moneys"
        },
        "moneysOriginal": {
          "$ref": "#/definitions/Moneys"
        },
        "localTimeOriginal": {
          "type": "string",
          "pattern": "^\\d{4}-[01]\\d-[0-3]\\dT[012]\\d:[012345]\\d:[012345]\\d.\\d{3}$"
        },
        "anomalTypeOriginal": {
          "type": "string",
          "enum": [
            "NONE",
            "SZ",
            "OK",
            "DB"
          ]
        },
        "isReversal": {
          "type": "boolean",
          "description": "Признак того, что транзакция является реверсом"
        }
      }
    },
    "Parties": {
      "type": "object",
      "additionalProperties": false,
      "required": [
