    "Caps": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "icc": {
          "type": "boolean",
          "description": "Поддержка чиповых карт"
        },
        "keyEntry": {
          "type": "boolean",
          "description": "Поддержка ручного ввода"
        },
        "contactless": {
          "type": "boolean",
          "description": "Поддержка бесконтактных платежей"
        },
        "magRead": {
          "type": "boolean",
          "description": "Возможность чтения магнитной полосы"
        },
        "magWrite": {
          "type": "boolean",
          "description": "Возможность записи на магнитную полосу"
        },
        "ocr": {
          "type": "boolean",
          "description": "Оптическое распознавание"
        },
        "singleTap": {
          "type": "boolean",
          "description": "Поддержка однократного касания"
        },
        "barCode": {
          "type": "boolean",
          "description": "Поддержка штрих-кодов"
        },
        "pin": {
          "type": "boolean",
          "description": "Поддержка ввода PIN-кода"
        },
        "maxPinLen": {
          "type": "integer",
          "minimum": 0,
          "maximum": 12,
          "description": "Максимальная длина PIN-кода"
        },
        "signAnalysis": {
          "type": "boolean",
          "description": "Анализ подписи"
        },
        "cardCapture": {
          "type": "boolean",
          "description": "Возможность изъятия карты"
        },
        "attendance": {
          "type": "boolean",
          "description": "Требуется присутствие оператора"
        },
        "mpos": {
          "type": "boolean",
          "description": "Мобильный POS"
        },
        "mobile": {
          "type": "boolean",
          "description": "Мобильное устройство"
        },
        "dsrp": {
          "type": "boolean",
          "description": "Поддержка DSRP"
        },
        "interactive": {
          "type": "boolean",
          "description": "Интерактивный режим"
        },
        "goodsAuthOnly": {
          "type": "boolean",
          "description": "Только продуктовая авторизация"
        },
        "partialApproval": {
          "type": "boolean",
          "description": "Частичное одобрение"
        }
      }
