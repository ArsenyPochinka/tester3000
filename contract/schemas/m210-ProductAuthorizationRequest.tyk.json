    "ProductAuthorizationRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rId",
        "userAgent",
        "systemCode",
        "ip",
        "cbiRequest",
        "msName"
      ],
      "properties": {
        "rId": {
          "$ref": "#/definitions/Rid"
        },
        "userAgent": {
          "type": "string",
          "maxLength": 255,
          "example": "RadixWare",
          "description": "Описание устройства клиента API"
        },
        "systemCode": {
          "type": "string",
          "maxLength": 255,
          "example": "2218",
          "description": "РИС код системы, инициирующей вызов"
        },
        "ip": {
          "type": "string",
          "description": "IP адрес вызывающего",
          "example": "1.0.8.23",
          "maxLength": 255
        },
        "cbiRequest": {
          "$ref": "#/definitions/CbiRequest"
        },
        "stornoAdditionalAttributes": {
          "$ref": "#/definitions/StornoAdditionalAttributes"
        },
        "msName": {
          "type": "string",
          "maxLength": 255,
          "example": "m263",
          "description": "Система-источник входящего сообщения"
        }
      }
    },
    "Rid": {
      "type": "string",
      "example": "eaac2a18-7a87-4cbf-bf1b-fcb3b69a846c",
      "description": "Идентификатор запроса в формате UUID v4",
      "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$"
