      "properties": {
        "tds": {
          "type": "object",
          "properties": {
            "condition": {
              "type": "string",
              "maxLength": 255,
              "description": "Условия 3D Secure"
            }
          },
          "additionalProperties": false
        },
        "auth": {
          "type": "object",
          "properties": {
            "presence": {
              "type": "boolean",
