          "pattern": "^\\d{4}-[01]\\d-[0-3]\\dT[012]\\d:[012345]\\d:[012345]\\d.\\d{3}$"
        },
        "entryMode": {
          "type": "string",
          "maxLength": 255,
          "example": "Icc",
          "description": "Способ ввода карты"
        }
      }
    },
    "Moneys": {
