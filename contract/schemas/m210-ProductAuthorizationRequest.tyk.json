        "mcc": {
          "type": "integer",
          "format": "int64",
          "minimum": 0,
          "maximum": 9999,
          "example": 5200,
          "description": "Код категории мерчанта"
        },
        "title": {
          "type": "string",
          "maxLength": 255,
          "example": "LEMANAPRO_RSB_***",
