        "country": {
          "type": "integer",
          "format": "int64",
          "minimum": 0,
          "maximum": 999,
          "example": 643,
          "description": "Код страны"
        },
        "zip": {
          "type": "string",
          "maxLength": 255,
          "example": "185014",
          "description": "Почтовый индекс"
        },
        "streetAddress": {
          "type": "string",
          "maxLength": 255,
          "description": "Адрес"
        },
        "ccyResidenceCountries": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "maximum": 999
          }
        },
        "documents": {
          "type": "object",
          "title": "OrganizationDocuments",
          "additionalProperties": false,
          "properties": {
            "document": {
              "type": "array",
              "maxItems": 100,
